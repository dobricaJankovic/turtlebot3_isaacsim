Generated from Composed Stage of root layer /ws/src/turtlebot3_isaacsim/models/turtlebot3_burger/turtlebot3_burger.usd/turtlebot3_burger/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "turtlebot3_burger"
{
    over "Physics"
    {
        over "wheel_left_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "wheel_right_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

