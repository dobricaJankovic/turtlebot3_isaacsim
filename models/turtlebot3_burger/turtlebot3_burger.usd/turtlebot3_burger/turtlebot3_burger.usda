#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "turtlebot3_burger"
    doc = """Generated from Composed Stage of root layer /tmp/tmpncdvosru/turtlebot3_burger.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_turtlebot3_burger_metgmfqp/usdex_turtlebot3_burger/turtlebot3_burger.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_turtlebot3_burger_metgmfqp/temp_turtlebot3_burger/turtlebot3_burger.usd


Generated from Composed Stage of root layer /ws/src/turtlebot3_isaacsim/models/turtlebot3_burger/turtlebot3_burger.usd/turtlebot3_burger/payloads/base.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "turtlebot3_burger" (
    prepend references = @./payloads/base.usda@
    variants = {
        string Physics = "physx"
    }
    append variantSets = "Physics"
)
{
    over "Geometry"
    {
        over "base_footprint" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            rel material:binding:physics = </turtlebot3_burger/Geometry/base_footprint/PhysicsMaterials/chassis> (
                bindMaterialAs = "weakerThanDescendants"
            )

            def "PhysicsMaterials"
            {
                def Material "wheel" (
                    prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
                )
                {
                    float physics:dynamicFriction = 1
                    float physics:restitution = 0
                    float physics:staticFriction = 1
                    uniform token physxMaterial:restitutionCombineMode = "min"
                }

                def Material "chassis" (
                    prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
                )
                {
                    float physics:dynamicFriction = 0.1
                    float physics:restitution = 0
                    float physics:staticFriction = 0.1
                    uniform token physxMaterial:frictionCombineMode = "min"
                    uniform token physxMaterial:restitutionCombineMode = "min"
                }
            }

            over "wheel_left_link"
            {
                over "cylinder" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </turtlebot3_burger/Geometry/base_footprint/PhysicsMaterials/wheel> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                }
            }

            over "wheel_right_link"
            {
                over "cylinder" (
                    prepend apiSchemas = ["MaterialBindingAPI"]
                )
                {
                    rel material:binding:physics = </turtlebot3_burger/Geometry/base_footprint/PhysicsMaterials/wheel> (
                        bindMaterialAs = "weakerThanDescendants"
                    )
                }
            }
        }
    }
    variantSet "Physics" = {
        "mujoco" (
            prepend payload = @./payloads/Physics/mujoco.usda@
        ) {

        }
        "none" {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
        "physx" (
            prepend payload = @./payloads/Physics/physx.usda@
        ) {

        }
    }
}

